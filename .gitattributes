* text=auto
EED/** text=auto

# Track public image assets with Git LFS so they can live in GitHub cleanly.
EED/backend/public/app/assets/*.jpg filter=lfs diff=lfs merge=lfs -text
EED/backend/public/app/assets/*.png filter=lfs diff=lfs merge=lfs -text
EED/backend/public/app/assets/*.webp filter=lfs diff=lfs merge=lfs -text
EED/backend/public/app/assets/*.gif filter=lfs diff=lfs merge=lfs -text
